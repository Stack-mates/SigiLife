# Use a flat, npm-like node_modules. pnpm's default isolated layout breaks
# resolution for tools that expect hoisting — Prisma's generated client
# (@prisma/client → .prisma/client), Next, and eslint-config-next's bundled
# plugins. Hoisting keeps pnpm's store/workspaces/Turborepo benefits while
# matching the resolution the codebase was written against (it came from npm).
node-linker=hoisted

generator client {
  provider = "prisma-client-ts"
  output   = "./generated"
}

datasource db {
    provider = "mysql"
}

model User {
  id                    Int          @id @default(autoincrement())
  username              String?      @unique @db.VarChar(100)
  email                 String       @unique @db.VarChar(255)
  name                  String?      @db.VarChar(255)
  picture               String?      @db.VarChar(500)
  googleId              String?      @unique @db.VarChar(255)
  avatar                Int          @default(0)
  theme                 Int          @default(1)
  color_theme           String       @default("null") @db.VarChar(50)
  homeTeam              Int          @default(0)
  lightOrDark           Int          @default(1)
  isAdmin               Boolean      @default(false)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  homeLocation          String?      @db.VarChar(500)
  hasCompletedTutorial  Boolean      @default(false)
  sigilCount            Int          @default(0)
  destroyCount          Int          @default(0)
  sigils                Sigil[]
  sigilVotes            SigilVote[]
  activities            Activity[]
  following             Follow[]     @relation("follower")
  followers             Follow[]     @relation("following")
  arPlacement           ArPlacement?

  @@map("users")
}

model Sigil {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(100)
  userId       Int
  intention    String?      @db.Text
  canvasData   String?      @db.LongText
  imageData    String?      @db.LongText
  isCharged    Boolean      @default(false)
  locationName String?      @db.VarChar(200)
  latitude     Decimal?     @db.Decimal(10, 8)
  longitude    Decimal?     @db.Decimal(11, 8)
  createdAt    DateTime     @default(now())
  sigilGroups  SigilGroup[]
  arPlacement  ArPlacement?
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chargeScore  Int          @default(0)
  destroyScore Int          @default(0)
  votes        SigilVote[]
  @@map("sigils")
}

model SigilVote {
  id        Int      @id @default(autoincrement())
  sigilId   Int
  userId    Int
  voteType  String   @db.VarChar(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sigil     Sigil    @relation(fields: [sigilId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sigilId, userId])
  @@index([sigilId])
  @@index([userId])
  @@map("sigil_votes")
}


model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower    User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model SigilGroup {
  id          Int    @id @default(autoincrement())
  sigilId     Int
  groupMember String @db.VarChar(100)
  sigil       Sigil  @relation(fields: [sigilId], references: [id], onDelete: Cascade)

  @@index([sigilId])
  @@map("sigil_groups")
}

model Activity {
  id          Int      @id @default(autoincrement())
  userId      Int
  fromUserId  Int?
  type        String   @db.VarChar(50)
  message     String   @db.VarChar(500)
  isNarrative Boolean  @default(false)
  dismissed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("activities")
}




model SvgVector {
  id         Int      @id @default(autoincrement())
  sigilId    Int?     @map("sigil_id")
  filename   String   @db.Text
  vectorData String   @map("vector_data") @db.Text
  width      Int
  height     Int
  fileSize   Int      @map("file_size")
  createdAt  DateTime @default(now())
  @@map("svg_vectors")
}

model sessions {
  session_id String  @id @db.VarChar(128)
  expires    Int     @db.UnsignedInt
  data       String? @db.MediumText
  @@map("sessions")
}

model ArPlacement {
  id           Int        @id @default(autoincrement())
  userId       Int        @unique
  sigilId      Int        @unique
  posX         Decimal    @db.Decimal(10, 5)
  posY         Decimal    @db.Decimal(10, 5)
  posZ         Decimal    @db.Decimal(10, 5)
  rotationX    Decimal    @db.Decimal(10, 5)
  rotationY    Decimal    @db.Decimal(10, 5)
  rotationZ    Decimal    @db.Decimal(10, 5)
  rotationW    Decimal    @db.Decimal(10, 5)
  createdAt    DateTime   @default(now())

  sigil        Sigil      @relation(fields: [sigilId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ar_placements")
}

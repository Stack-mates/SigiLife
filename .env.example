# ─── SigiLife environment template ───────────────────────────────────────────
# Copy to .env.local (Next.js) and fill in real values.
# NEVER commit real secrets. This file is the single source of truth for which
# variables exist — if you add one, document it here AND in ARCHITECTURE.md.

# Postgres connection string.
# Local dev via docker-compose: postgresql://sigilife:sigilife@localhost:5432/sigilife
# Production (self-hosted, ADR-012): app talks to the db container.
DATABASE_URL="postgresql://sigilife:sigilife@localhost:5432/sigilife"

# Postgres container credentials (used by docker-compose.yml db service).
# Must match the user/password/db in DATABASE_URL.
POSTGRES_USER="sigilife"
POSTGRES_PASSWORD="sigilife"
POSTGRES_DB="sigilife"

# Auth.js (NextAuth v5) — generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Mapbox public token (client-side; pk.* token, safe to expose)
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Stripe (monetization — see docs/features/monetization.md)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PREMIUM_MONTHLY_PRICE_ID=""
STRIPE_PREMIUM_YEARLY_PRICE_ID=""
STRIPE_FOUNDER_PRICE_ID=""

# Public URL for Stripe redirect (success_url / cancel_url in checkout sessions)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Profanity filter for sigil intentions (https://apilayer.com/marketplace/bad_words-api)
BAD_WORDS_API_KEY=""
